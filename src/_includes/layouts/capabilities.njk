---
layout: layouts/base.njk
---
{% set prefix = "/en" if lang == "en" else "" %}
<main id="main-content">
  <section class="page-hero page-hero-dark">
    <img class="hero-media" src="/images/web/laser-cutting.jpg" alt="" loading="eager" fetchpriority="high" eleventy:widths="640,960,1440,1920" sizes="100vw">
    <div class="container page-hero-inner">
      <nav class="breadcrumbs"><a href="{{ prefix }}/">{% if lang == "en" %}Home{% else %}首页{% endif %}</a><span>/</span><span>{% if lang == "en" %}Capabilities{% else %}制造能力{% endif %}</span></nav>
      <span class="eyebrow">MANUFACTURING CAPABILITIES</span>
      <h1>{% if lang == "en" %}Industrial knife manufacturing and inspection capabilities{% else %}工业刀具制造与检测能力{% endif %}</h1>
      <p>{% if lang == "en" %}Blade shaping, heat treatment, machining, grinding and inspection processes are configured according to product geometry, material, drawings and operating requirements.{% else %}依据产品结构、材料、图纸及工况要求，配置刀坯成形、热处理、机加工、研磨与检测等工艺环节。{% endif %}</p>
    </div>
  </section>
  <section class="section section-system">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">ENGINEERING SYSTEM</span><h2>{% if lang == "en" %}Core manufacturing and inspection capabilities{% else %}核心制造与检测能力{% endif %}</h2></div><p>{% if lang == "en" %}Blade shaping, heat treatment, precision machining, grinding and inspection jointly support geometry, edge and batch requirements.{% else %}刀坯成形、热处理、精密加工、研磨与检测共同支撑刀具几何、刃口及批次要求。{% endif %}</p></div>
      <div class="capability-list">{% for capability in catalog.capabilities %}{% include "partials/capability-card.njk" %}{% endfor %}</div>
    </div>
  </section>
  <section class="section process-evidence" aria-labelledby="process-evidence-title">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">CONTROLLED PROCESS</span><h2 id="process-evidence-title">{% if lang == "en" %}Eight manufacturing and control stages{% else %}八道制造与质量控制工序{% endif %}</h2></div>
        <p>{% if lang == "en" %}Real production media from the Zhangzhou base shows the route from incoming material checks to protective packaging. The exact route remains subject to blade geometry, material and approved technical requirements.{% else %}以下实拍素材展示漳州基地从来料核对到包装防护的工艺路径，具体工序仍需依据刀型、材料及经确认的技术要求安排。{% endif %}</p>
      </div>
      <ol class="process-evidence-list">
        {% for process in manufacturingProcesses %}
        <li class="process-evidence-row" id="process-{{ process.slug }}">
          <div class="process-evidence-visuals">
            <div class="process-evidence-media">
              {% if process.video %}
              <video data-process-video muted loop playsinline preload="none" poster="{{ process.media }}" aria-hidden="true" tabindex="-1">
                <source data-src="{{ process.video }}" type="video/mp4">
              </video>
              {% else %}
              <img src="{{ process.media }}" alt="{{ process.alt[lang] }}" loading="lazy" width="1280" height="720">
              {% endif %}
            </div>
            {% if process.supportingMedia %}
            <div class="process-evidence-supporting">
              {% for supporting in process.supportingMedia %}
              <figure class="process-evidence-detail">
                <img src="{{ supporting.media }}" alt="{{ supporting.alt[lang] }}" loading="lazy" width="960" height="540">
                <figcaption>{{ supporting.caption[lang] }}</figcaption>
              </figure>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          <div class="process-evidence-copy">
            <span class="process-evidence-number">{{ process.number }}</span>
            <h3>{{ process.title[lang] }}</h3>
            <p>{{ process.detail[lang] }}</p>
          </div>
        </li>
        {% endfor %}
      </ol>
      <p class="process-evidence-note">{% if lang == "en" %}Media is selected to show working methods without disclosing controlled drawings, inspection records or process parameters.{% else %}网页素材仅用于展示作业方式，不公开受控图纸、检验记录或具体工艺参数。{% endif %}</p>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">MANUFACTURING FLOOR</span><h2>{% if lang == "en" %}Manufacturing floor at the Zhangzhou base{% else %}漳州基地制造现场{% endif %}</h2></div>
        <p>{% if lang == "en" %}The photographs show machining equipment lines, the equipment area and laser cutting equipment within the current production environment.{% else %}以下照片展示漳州基地当前生产环境中的机加工设备列阵、设备加工区域与激光切割设备。{% endif %}</p>
      </div>
      <div class="manufacturing-photo-grid">
        <figure class="manufacturing-photo"><img src="/images/web/factory-20260722/machining-equipment-line.jpg" alt="{% if lang == 'en' %}Machining equipment line at the Zhangzhou base{% else %}漳州基地机加工设备列阵{% endif %}" loading="lazy" eleventy:widths="480,720,960,1280" sizes="(min-width: 768px) 33vw, 100vw"><figcaption>{% if lang == "en" %}Machining equipment line{% else %}机加工设备列阵{% endif %}</figcaption></figure>
        <figure class="manufacturing-photo"><img src="/images/web/factory-20260722/machining-equipment-area.jpg" alt="{% if lang == 'en' %}Machining equipment area at the Zhangzhou base{% else %}漳州基地机加工设备区域{% endif %}" loading="lazy" eleventy:widths="480,720,960,1280" sizes="(min-width: 768px) 33vw, 100vw"><figcaption>{% if lang == "en" %}Machining equipment area{% else %}机加工设备区域{% endif %}</figcaption></figure>
        <figure class="manufacturing-photo"><img src="/images/web/factory-20260722/laser-cutting-equipment.jpg" alt="{% if lang == 'en' %}Laser cutting equipment at the Zhangzhou base{% else %}漳州基地激光切割设备{% endif %}" loading="lazy" eleventy:widths="480,720,960,1280" sizes="(min-width: 768px) 33vw, 100vw"><figcaption>{% if lang == "en" %}Laser cutting equipment{% else %}激光切割设备{% endif %}</figcaption></figure>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container evidence-table">
      <div class="evidence-row"><strong>INPUT / {% if lang == "en" %}TECHNICAL DATA{% else %}技术资料{% endif %}</strong><span>{% if lang == "en" %}Drawing, physical sample, machine information, processed material and quantity{% else %}图纸、实物样品、设备信息、被处理材料及需求数量{% endif %}</span></div>
      <div class="evidence-row"><strong>PROCESS / {% if lang == "en" %}MANUFACTURING{% else %}制造工艺{% endif %}</strong><span>{% if lang == "en" %}Material review, blade shaping, heat treatment, machining and grinding{% else %}材料评估、刀坯成形、热处理、机加工及研磨{% endif %}</span></div>
      <div class="evidence-row"><strong>CONTROL / {% if lang == "en" %}QUALITY{% else %}质量控制{% endif %}</strong><span>{% if lang == "en" %}Material, dimensions, hardness, edge geometry and acceptance criteria{% else %}材料、尺寸、硬度、刃口几何及验收标准{% endif %}</span></div>
      <div class="evidence-row"><strong>OUTPUT / {% if lang == "en" %}DELIVERY{% else %}交付结果{% endif %}</strong><span>{% if lang == "en" %}Validated samples, series production and applicable batch records{% else %}验证样品、批量制造及适用的批次记录{% endif %}</span></div>
    </div>
  </section>
  {% include "partials/rfq-cta.njk" %}
</main>
