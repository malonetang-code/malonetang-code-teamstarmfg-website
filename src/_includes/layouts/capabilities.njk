---
layout: layouts/base.njk
---
{% set prefix = "/en" if lang == "en" else "" %}
<main id="main-content">
  <section class="page-hero page-hero-dark">
    <img class="hero-media" src="/images/web/laser-cutting.jpg" alt="" loading="eager" fetchpriority="high" eleventy:widths="640,960,1440,1920" sizes="100vw">
    <div class="container page-hero-inner">
      <nav class="breadcrumbs"><a href="{{ prefix }}/">{% if lang == "en" %}Home{% else %}首页{% endif %}</a><span>/</span><span>{% if lang == "en" %}Capabilities{% else %}制造能力{% endif %}</span></nav>
      <span class="eyebrow">MANUFACTURING CAPABILITIES</span>
      <h1>{% if lang == "en" %}Industrial knife manufacturing and inspection capabilities{% else %}工业刀具制造与检测能力{% endif %}</h1>
      <p>{% if lang == "en" %}Blade shaping, heat treatment, machining, grinding and inspection processes are configured according to product geometry, material, drawings and operating requirements.{% else %}依据产品结构、材料、图纸及工况要求，配置刀坯成形、热处理、机加工、研磨与检测等工艺环节。{% endif %}</p>
    </div>
  </section>
  <section class="section section-system">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">ENGINEERING SYSTEM</span><h2>{% if lang == "en" %}Core manufacturing and inspection capabilities{% else %}核心制造与检测能力{% endif %}</h2></div><p>{% if lang == "en" %}Blade shaping, heat treatment, precision machining, grinding and inspection jointly support geometry, edge and batch requirements.{% else %}刀坯成形、热处理、精密加工、研磨与检测共同支撑刀具几何、刃口及批次要求。{% endif %}</p></div>
      <div class="capability-list">{% for capability in catalog.capabilities %}{% include "partials/capability-card.njk" %}{% endfor %}</div>
    </div>
  </section>
  <section class="section">
    <div class="container evidence-table">
      <div class="evidence-row"><strong>INPUT / {% if lang == "en" %}TECHNICAL DATA{% else %}技术资料{% endif %}</strong><span>{% if lang == "en" %}Drawing, physical sample, machine information, processed material and quantity{% else %}图纸、实物样品、设备信息、被处理材料及需求数量{% endif %}</span></div>
      <div class="evidence-row"><strong>PROCESS / {% if lang == "en" %}MANUFACTURING{% else %}制造工艺{% endif %}</strong><span>{% if lang == "en" %}Material review, blade shaping, heat treatment, machining and grinding{% else %}材料评估、刀坯成形、热处理、机加工及研磨{% endif %}</span></div>
      <div class="evidence-row"><strong>CONTROL / {% if lang == "en" %}QUALITY{% else %}质量控制{% endif %}</strong><span>{% if lang == "en" %}Material, dimensions, hardness, edge geometry and acceptance criteria{% else %}材料、尺寸、硬度、刃口几何及验收标准{% endif %}</span></div>
      <div class="evidence-row"><strong>OUTPUT / {% if lang == "en" %}DELIVERY{% else %}交付结果{% endif %}</strong><span>{% if lang == "en" %}Validated samples, series production and applicable batch records{% else %}验证样品、批量制造及适用的批次记录{% endif %}</span></div>
    </div>
  </section>
  {% include "partials/rfq-cta.njk" %}
</main>
