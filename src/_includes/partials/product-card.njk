{% set prefix = "/en" if lang == "en" else "" %}
<article class="product-card{% if not product.image %} product-card-no-media{% endif %}">
  {% if product.image %}
  <a class="product-image" href="{{ prefix }}/products/{{ product.slug }}/">
    <img src="{{ product.image }}" alt="{{ product.name[lang] }}" loading="lazy" eleventy:widths="240,480,720" sizes="(min-width: 1080px) 31vw, (min-width: 600px) 48vw, 100vw">
  </a>
  {% endif %}
  <div class="product-card-body">
    <span class="eyebrow">{{ product.code }}</span>
    <h3><a href="{{ prefix }}/products/{{ product.slug }}/">{{ product.name[lang] }}</a></h3>
    <dl class="product-card-specs">
      <div><dt>{% if lang == "en" %}Typical equipment{% else %}典型设备{% endif %}</dt><dd>{{ product.equipment[lang] }}</dd></div>
      <div><dt>{% if lang == "en" %}Processed materials{% else %}适用材料{% endif %}</dt><dd>{{ product.materials[lang] }}</dd></div>
    </dl>
    <a class="text-link" href="{{ prefix }}/products/{{ product.slug }}/">{% if lang == "en" %}View product and RFQ details{% else %}查看产品与询价资料{% endif %}<span aria-hidden="true">→</span></a>
  </div>
</article>
