{
  "name": "teamstar-manufacturing-website",
  "private": true,
  "version": "3.0.0",
  "description": "Bilingual static website for Teamstar Manufacturing",
  "scripts": {
    "build": "eleventy && node scripts/optimize-build.js",
    "build:review": "node scripts/build-github-review.js",
    "build:approved-production": "node scripts/build-approved-review-production.mjs",
    "photos:process": "node scripts/process-product-photo-library.js",
    "process:manufacturing": "node scripts/process-manufacturing-media.js",
    "serve": "eleventy --serve --port=8080",
    "clean": "rm -rf dist",
    "check:content": "node scripts/check-content.js",
    "check:build": "node scripts/check-build.js",
    "check:products": "node scripts/check-product-library.js",
    "check:factory": "node scripts/check-factory-evidence.js",
    "check:process": "node scripts/check-manufacturing-process.js",
    "check:quality": "node scripts/check-quality.js",
    "check:schema": "node scripts/check-structured-data.js",
    "check:rfq": "node scripts/check-rfq.js",
    "check:geo": "node scripts/check-ai-geo.js",
    "check:approved-production": "node scripts/check-approved-production.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-img": "^6.0.4",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.49.0"
  }
}
