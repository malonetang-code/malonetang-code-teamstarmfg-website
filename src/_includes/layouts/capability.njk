---
layout: layouts/base.njk
---
{% set prefix = "/en" if lang == "en" else "" %}
{% set capability = catalog.capabilities | findBySlug(capabilitySlug) %}
<main id="main-content">
  <section class="page-hero page-hero-dark" style="--hero-image: url('{{ capability.image }}')">
    <div class="container page-hero-inner">
      <nav class="breadcrumbs"><a href="{{ prefix }}/">{% if lang == "en" %}Home{% else %}首页{% endif %}</a><span>/</span><a href="{{ prefix }}/capabilities/">{% if lang == "en" %}Capabilities{% else %}制造能力{% endif %}</a><span>/</span><span>{{ capability.name[lang] }}</span></nav>
      <span class="eyebrow">{{ capability.code }}</span><h1>{{ capability.name[lang] }}</h1><p>{{ capability.summary[lang] }}</p>
    </div>
  </section>
  <section class="section section-system">
    <div class="container content-grid">
      <div class="content-block"><span class="eyebrow">PROCESS SUPPORT</span><h2>{% if lang == "en" %}Process and inspection support{% else %}工艺与检测支持{% endif %}</h2><ul class="plain-list">{% for item in capability.evidence[lang] %}<li>{{ item }}</li>{% endfor %}</ul></div>
      <aside><div class="notice">{% if lang == "en" %}Precision, working range and acceptance criteria are confirmed against the specific drawing and application requirement.{% else %}具体精度、加工范围和验收标准根据图纸与应用要求确认。{% endif %}</div></aside>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">PROCESS CONTROL</span><h2>{% if lang == "en" %}Process route and control requirements{% else %}工艺路线与控制要求{% endif %}</h2></div><p>{% if lang == "en" %}The process sequence and inspection items are defined according to blade family, material and validation requirements.{% else %}具体工序与检验项目依据刀具类别、材料及验证要求确定。{% endif %}</p></div>
      <div class="quality-flow">
        <div class="quality-flow-step"><b>01 / INPUT</b><h3>{% if lang == "en" %}Technical input{% else %}技术资料{% endif %}</h3><p>{% if lang == "en" %}Drawings, physical samples and operating conditions.{% else %}图纸、实物样品及使用工况。{% endif %}</p></div>
        <div class="quality-flow-step"><b>02 / REVIEW</b><h3>{% if lang == "en" %}Process planning{% else %}工艺制定{% endif %}</h3><p>{% if lang == "en" %}Material, geometry and manufacturing sequence.{% else %}材料、刀具几何及制造顺序。{% endif %}</p></div>
        <div class="quality-flow-step"><b>03 / VERIFY</b><h3>{% if lang == "en" %}Inspection{% else %}检验{% endif %}</h3><p>{% if lang == "en" %}Inspection against drawings and acceptance criteria.{% else %}依据图纸与验收标准执行检验。{% endif %}</p></div>
        <div class="quality-flow-step"><b>04 / RELEASE</b><h3>{% if lang == "en" %}Production release{% else %}生产放行{% endif %}</h3><p>{% if lang == "en" %}Prototype approval and release for series production.{% else %}样品确认及批量制造放行。{% endif %}</p></div>
      </div>
    </div>
  </section>
  {% include "partials/rfq-cta.njk" %}
</main>
