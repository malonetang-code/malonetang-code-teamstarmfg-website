{% set prefix = "/en" if lang == "en" else "" %}
<article class="product-card">
  <a class="product-image" href="{{ prefix }}/products/{{ product.slug }}/">
    <img src="{{ product.image }}" alt="{{ product.name[lang] }}" loading="lazy" eleventy:widths="240,480,720" sizes="(min-width: 1080px) 31vw, (min-width: 600px) 48vw, 100vw">
  </a>
  <div class="product-card-body">
    <span class="eyebrow">{{ product.code }}</span>
    <h3><a href="{{ prefix }}/products/{{ product.slug }}/">{{ product.name[lang] }}</a></h3>
    <p>{{ product.summary[lang] }}</p>
    <a class="text-link" href="{{ prefix }}/products/{{ product.slug }}/">{% if lang == "en" %}View product details{% else %}查看产品详情{% endif %}<span aria-hidden="true">→</span></a>
  </div>
</article>
