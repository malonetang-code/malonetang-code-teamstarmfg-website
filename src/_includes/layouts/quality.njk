---
layout: layouts/base.njk
---
{% set prefix = "/en" if lang == "en" else "" %}
<main id="main-content">
  <section class="page-hero page-hero-dark">
    <img class="hero-media" src="/images/web/quality-control.jpg" alt="" loading="eager" fetchpriority="high" eleventy:widths="640,960,1280,1600" sizes="100vw">
    <div class="container page-hero-inner">
      <nav class="breadcrumbs"><a href="{{ prefix }}/">{% if lang == "en" %}Home{% else %}首页{% endif %}</a><span>/</span><span>{% if lang == "en" %}Quality{% else %}质量体系{% endif %}</span></nav>
      <span class="eyebrow">QUALITY SYSTEM / ISO 9001:2015</span>
      <h1>{% if lang == "en" %}Quality control throughout manufacturing{% else %}制造全过程质量控制{% endif %}</h1>
      <p>{% if lang == "en" %}Material verification, in-process inspection, dimensional inspection and final inspection are performed against approved drawings and applicable product requirements.{% else %}材料确认、过程检验、尺寸检测与成品检验，依据确认版图纸及相应产品要求执行。{% endif %}</p>
    </div>
  </section>
  <section class="section section-system">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">PROCESS CONTROL</span><h2>{% if lang == "en" %}Manufacturing quality control process{% else %}质量控制流程{% endif %}</h2></div><p>{% if lang == "en" %}Inspection plans are defined according to the product, drawing and operating requirements and cover applicable material, dimensional and edge criteria.{% else %}检验方案依据产品、图纸及工况要求制定，覆盖相应的材料、尺寸与刃口标准。{% endif %}</p></div>
      <div class="quality-flow">
        <div class="quality-flow-step"><b>01 / REVIEW</b><h3>{% if lang == "en" %}Technical and material review{% else %}技术要求与材料确认{% endif %}</h3><p>{% if lang == "en" %}Confirm the drawing revision, material route and applicable inspection requirements.{% else %}确认图纸版本、材料路线及适用的检验要求。{% endif %}</p></div>
        <div class="quality-flow-step"><b>02 / IN-PROCESS</b><h3>{% if lang == "en" %}In-process inspection{% else %}过程检验{% endif %}</h3><p>{% if lang == "en" %}Apply controls during blade shaping, heat treatment, machining and grinding.{% else %}在刀坯成形、热处理、机加工及研磨过程中实施相应控制。{% endif %}</p></div>
        <div class="quality-flow-step"><b>03 / FINAL</b><h3>{% if lang == "en" %}Final inspection{% else %}成品检验{% endif %}</h3><p>{% if lang == "en" %}Verify the agreed material, dimensional and edge requirements.{% else %}检验已确认的材料、尺寸及刃口要求。{% endif %}</p></div>
        <div class="quality-flow-step"><b>04 / RELEASE</b><h3>{% if lang == "en" %}Batch release{% else %}批次放行{% endif %}</h3><p>{% if lang == "en" %}Release products against approved criteria and retain applicable records.{% else %}依据确认标准执行产品放行，并保留适用记录。{% endif %}</p></div>
      </div>
    </div>
  </section>
  <section class="section section-dark">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">INSPECTION EQUIPMENT</span><h2>{% if lang == "en" %}Material and dimensional inspection equipment{% else %}材料与尺寸检测设备{% endif %}</h2></div><p>{% if lang == "en" %}Spectrometry, coordinate measurement, image measurement and metallography support applicable material analysis, dimensional inspection and process verification.{% else %}光谱分析、三坐标测量、影像尺寸测量与金相检验，用于相应的材料分析、尺寸检测及过程验证。{% endif %}</p></div>
      <div class="quality-equipment-grid">
        <article class="equipment-item"><img src="/images/quality/spectrolab-spectrometer.jpeg" alt="SPECTROLAB spectrometer" loading="lazy" eleventy:widths="320,640" sizes="(min-width: 1080px) 24vw, (min-width: 600px) 48vw, 100vw"><div><strong>SPECTROLAB</strong><span>{% if lang == "en" %}Spectrometer / material analysis{% else %}光谱仪 / 材料分析{% endif %}</span></div></article>
        <article class="equipment-item"><img src="/images/quality/cmm-beyond-apex707.jpeg" alt="Mitutoyo BEYOND APEX 707 CMM" loading="lazy" eleventy:widths="320,640" sizes="(min-width: 1080px) 24vw, (min-width: 600px) 48vw, 100vw"><div><strong>Mitutoyo BEYOND APEX 707</strong><span>{% if lang == "en" %}Coordinate measuring machine{% else %}三坐标测量机{% endif %}</span></div></article>
        <article class="equipment-item"><img src="/images/quality/keyence-im7000.jpeg" alt="KEYENCE IM-7000" loading="lazy" eleventy:widths="320,640" sizes="(min-width: 1080px) 24vw, (min-width: 600px) 48vw, 100vw"><div><strong>KEYENCE IM-7000</strong><span>{% if lang == "en" %}Image dimension measurement{% else %}影像尺寸测量{% endif %}</span></div></article>
        <article class="equipment-item"><img src="/images/quality/nikon-metallographic-microscope.jpeg" alt="NIKON metallographic microscope" loading="lazy" eleventy:widths="320,640" sizes="(min-width: 1080px) 24vw, (min-width: 600px) 48vw, 100vw"><div><strong>NIKON</strong><span>{% if lang == "en" %}Metallographic microscope{% else %}金相显微镜{% endif %}</span></div></article>
      </div>
      <div class="section-actions"><a class="button button-outline" href="{% if lang == 'en' %}/images/certs/iso9001-en.pdf{% else %}/images/certs/iso9001-cn.pdf{% endif %}">{% if lang == "en" %}View ISO certificate{% else %}查看 ISO 证书{% endif %}</a></div>
    </div>
  </section>
  {% include "partials/rfq-cta.njk" %}
</main>
