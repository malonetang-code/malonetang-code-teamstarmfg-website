---
layout: layouts/base.njk
---
{% set prefix = "/en" if lang == "en" else "" %}
<main id="main-content">
  <section class="page-hero">
    <img class="hero-media" src="/images/web/product-parts.jpg" alt="" loading="eager" fetchpriority="high" eleventy:widths="640,960,1440,1920" sizes="100vw">
    <div class="container page-hero-inner">
      <nav class="breadcrumbs"><a href="{{ prefix }}/">{% if lang == "en" %}Home{% else %}首页{% endif %}</a><span>/</span><span>RFQ</span></nav>
      <span class="eyebrow">DRAWING / SAMPLE / APPLICATION</span>
      <h1>{% if lang == "en" %}Industrial knife RFQ{% else %}工业刀具技术询价{% endif %}</h1>
      <p>{% if lang == "en" %}Manufacturing review can be based on a complete drawing, physical sample, old blade, clear photographs or documented machine and operating conditions.{% else %}可提交完整图纸，也可提供实物样品、旧刀、清晰照片或设备与工况资料，用于制造评估。{% endif %}</p>
    </div>
  </section>
  <section class="section">
    <div class="container rfq-layout">
      <div>
        <span class="eyebrow">RFQ CHECKLIST</span>
        <h2>{% if lang == "en" %}Technical information for manufacturing review{% else %}技术评估所需资料{% endif %}</h2>
        <div class="rfq-checklist">
          <div class="rfq-check" id="drawing"><b>01</b><div><strong>{% if lang == "en" %}Drawing and revision{% else %}图纸及版本{% endif %}</strong><span>{% if lang == "en" %}Dimensions, tolerances, thickness, hole pattern and drawing revision.{% else %}尺寸、公差、厚度、孔位及图纸版本。{% endif %}</span></div></div>
          <div class="rfq-check" id="sample"><b>02</b><div><strong>{% if lang == "en" %}Physical sample or old-blade photos{% else %}实物样品或旧刀照片{% endif %}</strong><span>{% if lang == "en" %}Overall view, mounting interfaces, edge geometry and visible wear or failure conditions.{% else %}整体结构、安装接口、刃口几何及可见的磨损或失效情况。{% endif %}</span></div></div>
          <div class="rfq-check" id="application"><b>03</b><div><strong>{% if lang == "en" %}Machine and processed material{% else %}设备及被处理材料{% endif %}</strong><span>{% if lang == "en" %}Machine make and model, operating method and material being processed.{% else %}设备品牌型号、运行方式及被处理材料。{% endif %}</span></div></div>
          <div class="rfq-check"><b>04</b><div><strong>{% if lang == "en" %}Quantity and operating target{% else %}数量及使用目标{% endif %}</strong><span>{% if lang == "en" %}Prototype quantity, annual demand, current issue and target service life.{% else %}试样数量、年度需求、当前使用问题及预期使用寿命。{% endif %}</span></div></div>
        </div>
        <div class="notice" style="margin-top: 24px">{% if lang == "en" %}The current form does not accept file attachments. Send drawings and photographs to {{ site.email }} with the company name included in the subject line.{% else %}本表单暂不支持附件上传。图纸与照片请发送至 {{ site.email }}，并在邮件主题中注明公司名称。{% endif %}</div>
      </div>
      <form class="rfq-form" action="{{ site.formEndpoint }}" method="POST" data-rfq-form>
        <h2>{% if lang == "en" %}Submit an RFQ{% else %}提交询价{% endif %}</h2>
        <div class="form-grid two">
          <div class="field"><label for="rfq-name">{% if lang == "en" %}Name{% else %}姓名{% endif %}</label><input id="rfq-name" name="name" type="text" autocomplete="name" required></div>
          <div class="field"><label for="rfq-email">Email</label><input id="rfq-email" name="email" type="email" inputmode="email" autocomplete="email" required></div>
          <div class="field"><label for="rfq-company">{% if lang == "en" %}Company{% else %}公司{% endif %}</label><input id="rfq-company" name="company" type="text" autocomplete="organization"></div>
          <div class="field"><label for="rfq-phone">{% if lang == "en" %}Phone{% else %}电话{% endif %}</label><input id="rfq-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel"></div>
        </div>
        <div class="form-grid" style="margin-top: 16px">
          <div class="field"><label for="rfq-product">{% if lang == "en" %}Product or machine{% else %}刀具或设备{% endif %}</label><input id="rfq-product" name="product" type="text" required></div>
          <div class="field"><label for="rfq-message">{% if lang == "en" %}Technical requirements{% else %}技术要求{% endif %}</label><textarea id="rfq-message" name="message" required placeholder="{% if lang == 'en' %}Dimensions, processed material, quantity and current issue{% else %}尺寸、被处理材料、数量及当前使用问题{% endif %}"></textarea></div>
        </div>
        <input type="hidden" name="language" value="{{ lang }}">
        <div class="form-actions"><button class="button button-accent" type="submit">{% if lang == "en" %}Submit RFQ{% else %}提交询价{% endif %}</button><a class="button button-outline" href="mailto:{{ site.email }}">{% if lang == "en" %}Email drawings{% else %}邮件发送图纸{% endif %}</a></div>
        <div class="form-status" role="status" aria-live="polite" data-form-status></div>
      </form>
    </div>
  </section>
</main>
