{% set prefix = "/en" if lang == "en" else "" %}
<article class="capability-card">
  <img src="{{ capability.image }}" alt="{{ capability.name[lang] }}" loading="lazy" eleventy:widths="480,800,1200" sizes="(min-width: 768px) 33vw, 100vw">
  <div class="capability-card-body">
    <span class="eyebrow">{{ capability.code }}</span>
    <h3>{{ capability.name[lang] }}</h3>
    <p>{{ capability.summary[lang] }}</p>
    <a class="text-link" href="{{ prefix }}/capabilities/{{ capability.slug }}/">{% if lang == "en" %}View capability details{% else %}查看能力详情{% endif %}<span aria-hidden="true">→</span></a>
  </div>
</article>
