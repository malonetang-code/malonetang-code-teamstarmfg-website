{% set prefix = "/en" if lang == "en" else "" %}
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <strong>TEAMSTAR MANUFACTURING</strong>
      <p>{% if lang == "en" %}Custom industrial machine knives manufactured from drawings, physical samples and application requirements.{% else %}依据图纸、实物样品及工况要求定制制造工业机械刀具。{% endif %}</p>
    </div>
    <div class="footer-column">
      <strong>{% if lang == "en" %}Explore{% else %}网站导航{% endif %}</strong>
      <a href="{{ prefix }}/products/">{% if lang == "en" %}Products{% else %}产品目录{% endif %}</a>
      <a href="{{ prefix }}/capabilities/">{% if lang == "en" %}Capabilities{% else %}制造能力{% endif %}</a>
      <a href="{{ prefix }}/quality/">{% if lang == "en" %}Quality{% else %}质量体系{% endif %}</a>
      <a href="{{ prefix }}/guides/">{% if lang == "en" %}Buyer Guides{% else %}采购指南{% endif %}</a>
      <a href="{{ prefix }}/rfq/">{% if lang == "en" %}Technical RFQ{% else %}技术询价{% endif %}</a>
      <a href="{{ prefix }}/rfq/custom-industrial-knife-drawing-checklist/">{% if lang == "en" %}RFQ preparation guide{% else %}询价资料指南{% endif %}</a>
    </div>
    <div class="footer-column">
      <strong>{% if lang == "en" %}Contact{% else %}联系方式{% endif %}</strong>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
      <span>{% if lang == "en" %}{{ site.addressEn }}{% else %}{{ site.addressZh }}{% endif %}</span>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 Teamstar Manufacturing</span>
    <span class="footer-bottom-links"><a href="{{ prefix }}/privacy/">{% if lang == "en" %}Privacy{% else %}隐私说明{% endif %}</a><a href="{{ site.icpUrl }}" target="_blank" rel="noopener">{{ site.icp }}</a></span>
  </div>
</footer>
